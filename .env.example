# Copy to .env and edit.
# Local Postgres (create the DB first: CREATE DATABASE flood_tungkhru;)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/flood_tungkhru

# local = save images in ./uploads ; cloudinary = Cloudinary ; supabase = Supabase Storage
STORAGE_BACKEND=local
CLOUDINARY_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=flood-images

# Reject reports outside Thung Khru (set false while testing from elsewhere)
ENFORCE_BOUNDARY=true
DECAY_HOURS=6
HEX_RESOLUTION=9

# Rain forecast: access token from https://data.tmd.go.th/nwpapi/ (free sign-up)
TMD_OPENDATA=
RAIN_CACHE_MINUTES=60

# DB connection pool (keep small on Supabase free tier)
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# --- Production (set these in Render, never in git) ---
# DATABASE_URL is filled in by Render from the flood-db database (render.yaml)
# STORAGE_BACKEND=cloudinary
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
