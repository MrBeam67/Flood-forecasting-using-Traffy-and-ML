# Copy to .env and edit.
# Local Postgres (create the DB first: CREATE DATABASE flood_tungkhru;)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/flood_tungkhru

# local = save images in ./uploads ; supabase = Supabase Storage
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=flood-images

# Reject reports outside Thung Khru (set false while testing from elsewhere)
ENFORCE_BOUNDARY=true
DECAY_HOURS=6
HEX_RESOLUTION=9
